<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- MAIN CONTENT -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- APP BAR -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Stock Audit"
                style="@style/Widget.Material3.Toolbar"/>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:background="?colorSurfaceVariant"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SCREEN TITLE -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Audit Via"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="?colorOnSurface"
                    android:layout_marginBottom="12dp"/>

                <!-- BARCODE / RFID TOGGLE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupAudit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBarcode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Barcode"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRfid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RFID"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>


                <!-- SCAN AREA -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <!-- BARCODE SEARCH (DEFAULT visible) -->
                    <LinearLayout
                        android:id="@+id/barcodeControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etScanCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Scan barcode here"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCam"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_scan"
                            app:iconSize="24dp"
                            app:iconGravity="textStart"
                            style="@style/Widget.Material3.Button.OutlinedButton"/>
                    </LinearLayout>

                    <!-- RFID FULL-WIDTH BUTTON (hidden initially) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartRfid"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Start Scan RFID"
                        android:visibility="gone"
                        android:icon="@drawable/ic_scan"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"/>
                </FrameLayout>


                <!-- STOCK LIST CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:cardUseCompatPadding="true"
                    app:strokeWidth="1dp"
                    app:strokeColor="?colorOutline"
                    app:cardBackgroundColor="?colorSurfaceVariant">

                    <LinearLayout
                        android:layout_width="366dp"
                        android:layout_height="421dp"
                        android:minHeight="280dp"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="16dp">

                        <include
                            android:id="@+id/item1"
                            layout="@layout/item_stock_audit" />

                        <include
                            android:id="@+id/item2"
                            layout="@layout/item_stock_audit" />

                        <include
                            android:id="@+id/item3"
                            layout="@layout/item_stock_audit" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <!-- ACTION BUTTONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLEAR"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_marginEnd="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAVE"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
