<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- Default: NO cleartext except explicitly allowed -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>

    <!-- PRODUCTION (HTTPS only) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">apps.galla.ai</domain>
    </domain-config>

    <!-- DEVELOPMENT (Allow HTTP for local Laravel server) -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android Emulator -> Host PC -->
        <domain includeSubdomains="true">10.0.2.2</domain>

        <!-- Localhost variations -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>

        <!-- Your LAN IP (for testing on real device or emulator) -->
        <domain includeSubdomains="true">192.168.1.50</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.1.56</domain>
    </domain-config>

</network-security-config>
