<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="amber_600">#EBCB8B</color>
    <color name="black">#2E3440</color>
    <color name="card_background">#F8F9FA</color>
    <color name="dark_grey">#3B4252</color>
    <color name="green_700">#A3BE8C</color>
    <color name="grey_600">#4C566A</color>
    <color name="light_grey">#ECEFF4</color>
    <color name="red_700">#BF616A</color>
    <color name="sc_accent">#81A1C1</color>
    <color name="sc_primary">#2E3440</color>
    <color name="sc_primary_dark">#1A1F2E</color>
    <color name="sleep_accent">#81A1C1</color>
    <color name="sleep_primary">#2E3440</color>
    <color name="sleep_primary_dark">#1A1F2E</color>
    <color name="sleep_secondary">#88C0D0</color>
    <color name="teal_300">#81A1C1</color>
    <color name="teal_500">#88C0D0</color>
    <color name="teal_700">#2E3440</color>
    <color name="white">#FFFFFF</color>
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="nav_header_height">160dp</dimen>
    <dimen name="nav_header_vertical_spacing">16dp</dimen>
    <string name="app_name" translatable="false">RFID App</string>
    <string name="nav_header_subtitle">Manufacturing Tracker</string>
    <string name="nav_header_title">Sleep Company</string>
    <string name="navigation_drawer_close">Close navigation drawer</string>
    <string name="navigation_drawer_open">Open navigation drawer</string>
    <style name="SleepButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">12dp</item>
        <item name="backgroundTint">@color/sc_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="SleepButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/sc_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/sc_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="SleepTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/sc_primary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/grey_600</item>
        <item name="android:textColorHint">@color/grey_600</item>
    </style>
    <style name="Theme.SleepCompanyWeb" parent="Theme.Material3.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/sc_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/sleep_secondary</item>
        <item name="colorOnPrimaryContainer">@color/sc_primary</item>

        
        <item name="colorSecondary">@color/sleep_secondary</item>
        <item name="colorOnSecondary">@color/sc_primary</item>
        <item name="colorSecondaryContainer">@color/sleep_accent</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/light_grey</item>
        <item name="colorOnSurfaceVariant">@color/grey_600</item>

        
        <item name="android:colorBackground">@color/light_grey</item>
        <item name="colorOnBackground">@color/black</item>

        
        <item name="android:statusBarColor">@color/sc_primary</item>
        <item name="android:navigationBarColor">@color/sc_primary</item>

        
        <item name="colorError">@color/red_700</item>
        <item name="colorOnError">@color/white</item>

        
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/grey_600</item>
        <item name="android:windowBackground">@color/light_grey</item>
    </style>
</resources>