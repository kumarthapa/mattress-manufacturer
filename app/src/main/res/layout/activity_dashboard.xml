<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- MAIN CONTENT -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- APP BAR -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Dashboard"
                style="@style/Widget.Material3.Toolbar"/>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:background="?colorSurfaceVariant"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- KPI GRID -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <include
                        android:id="@+id/kpiTotalStock"
                        layout="@layout/item_kpi_material"/>

                    <include
                        android:id="@+id/kpiTotalSkus"
                        layout="@layout/item_kpi_material"/>

                    <include
                        android:id="@+id/kpiAudited"
                        layout="@layout/item_kpi_material"/>

                    <include
                        android:id="@+id/kpiVariance"
                        layout="@layout/item_kpi_material"/>
                </GridLayout>

                <!-- SECTION TITLE -->
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Audit Report"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="?colorOnSurface"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"/>

                <!-- TABLE CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    android:backgroundTint="?colorSurface">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <!-- HEADER -->
                        <TableRow
                            android:background="?colorPrimaryContainer">

                            <TextView
                                style="@style/TableHeader"
                                android:text="Audit Date"/>

                            <TextView
                                style="@style/TableHeader"
                                android:text="Items Audited"/>

                            <TextView
                                style="@style/TableHeader"
                                android:text="Variance"/>
                        </TableRow>

                        <!-- ROW 1 -->
                        <TableRow android:background="?colorSurface">
                            <TextView style="@style/TableCell" android:text="22 Dec 2025"/>
                            <TextView style="@style/TableCell" android:text="100"/>
                            <TextView style="@style/TableCell" android:text="+12"/>
                        </TableRow>

                        <!-- ROW 2 -->
                        <TableRow android:background="?colorSurface">
                            <TextView style="@style/TableCell" android:text="22 Dec 2025"/>
                            <TextView style="@style/TableCell" android:text="100"/>
                            <TextView style="@style/TableCell" android:text="+12"/>
                        </TableRow>

                    </TableLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
