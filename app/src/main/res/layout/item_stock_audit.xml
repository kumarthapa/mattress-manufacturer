<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- TITLE + BARCODE -->
    <LinearLayout
        android:id="@+id/leftTexts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rightControls"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Potato Chips"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvItemBarcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="123456677"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>

    <!-- RIGHT: system qty + physical qty controls -->
    <LinearLayout
        android:id="@+id/rightControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- SYSTEM STOCK (USED BY JAVA) -->
        <TextView
            android:id="@+id/tvItemSystemQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System: 100"
            android:textSize="12sp"
            android:textColor="?colorOnSurfaceVariant"
            android:layout_marginBottom="8dp"/>

        <!-- qty controls row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="-"
                android:textSize="18sp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <TextView
                android:id="@+id/tvItemPhysicalQty"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="5"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="18sp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>
        </LinearLayout>
    </LinearLayout>

    <!-- bottom divider -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?colorOutline"
        app:layout_constraintTop_toBottomOf="@id/leftTexts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
