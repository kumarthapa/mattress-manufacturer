<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SleepCompanyWeb">

        <!-- Login Activity as the Launcher -->
        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dashboard Activity -->
        <activity android:name=".DashboardActivity" android:exported="false" />

        <!-- Products List Activity -->
        <activity android:name=".ProductsActivity" android:exported="false" />

        <!-- Product Details Activity -->
        <activity android:name=".ProductDetailsActivity" android:exported="false" />

        <!-- RFID Scanner Activity -->
        <activity android:name=".ScannerActivity" android:exported="false" />

        <!-- Quality Control Activity -->
        <activity android:name=".QcActivity" android:exported="false" />

    </application>
</manifest>
